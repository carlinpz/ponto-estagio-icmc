# Modelo de configuração. Copie para .streamlit/secrets.toml (local, fora do git)
# ou cole no painel "Secrets" do Streamlit Cloud. TODOS os valores abaixo são fictícios.

# Web App do Apps Script (apps_script/Code.gs). Sem estas duas chaves o app funciona só com o JSON local.
apps_script_url = "https://script.google.com/macros/s/SEU_ID_DE_IMPLANTACAO/exec"
# Mesmo valor da propriedade SEGREDO em Apps Script > Configurações do projeto > Propriedades do script.
apps_script_secret = "troque-por-um-valor-aleatorio-longo"

# Login. Gere os hashes com:  python gerar_hash_senha.py
usuario_estagiario = "seu_usuario"
senha_estagiario_hash = "pbkdf2_sha256$600000$SALT_HEX$HASH_HEX"
senha_chefia_hash = "pbkdf2_sha256$600000$SALT_HEX$HASH_HEX"
# Assina o cookie "lembrar login" (30 dias). Trocar este valor desloga todos os navegadores.
# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(32))"
cookie_secret = "troque-por-um-valor-aleatorio-longo"

[perfil]
nome_estagiario = "Nome do(a) Estagiário(a)"
nome_supervisor = "Nome do(a) Supervisor(a)"
empresa_setor = "000000"
carga_horaria_diaria = 6.0
# dias_uteis = ["Segunda-feira", "Terça-feira", "Quarta-feira", "Quinta-feira", "Sexta-feira"]
